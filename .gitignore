node_modules/
dist/
.playwright-mcp/
walk-out/
# Patient scans: EVERYTHING under samples/ except its README, whatever the folders are called. The owner
# keeps adding and renaming them (2026-11-26: case-* became aligner/, denture/, retainer/), and a pattern
# on the old names left 41 patient files one `git add` away from a public repo.
samples/*
!samples/README.md
__pycache__/

# Agent and tool scratch, never part of the app.
.claude/
.codex/
.probe-tmp/
# The knowledge graph: graph.json and the report are kept (see CLAUDE.md); its cache and dated
# snapshots are rebuilt by `graphify update .` and would add ~100 MB to a public repo.
graphify-out/cache/
graphify-out/20*/

# Stitch: captures and the per-machine project binding. The project link lives in DESIGN.md.
.stitch/
.stitch.json

# Audit run logs. The evidence a review CITES is committed explicitly by path - a table that cites
# evidence nobody can open is the defect those reviews are about - and everything else here is a
# local by-product of a run that the commit can reproduce. Tracked files are unaffected by this.
artefacts/
