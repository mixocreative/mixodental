{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@mixo-geocore/host/*": ["./vendor/mixo-geocore/host/*"],
      "@mixo-geocore/editing/*": ["./vendor/mixo-geocore/editing/*"],
      "@mixo-geocore/engine": ["./vendor/mixo-geocore/pkg-browser/mixo_geometry_wasm.js"]
    }
  },
  "include": ["src", "vendor/mixo-geocore/host", "vendor/mixo-geocore/editing", "vite.config.ts"]
}
