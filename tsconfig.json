{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // A BINDING NOTHING READS IS A DEFECT, not untidiness - switched on 2026-11-09 after an audit.
    // The tool rail's `onPick` was destructured and never called: four buttons drawn in four states
    // and none of them pressable. Two document reviews, two readings of that file and a long
    // subagent audit found it; `noUnusedParameters` names it in one line, at compile time, for free.
    // It also replaces the grep-counting that was the only way to find an orphaned import here.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@mixo-geocore/host/*": ["./vendor/mixo-geocore/host/*"],
      "@mixo-geocore/editing/*": ["./vendor/mixo-geocore/editing/*"],
      "@mixo-geocore/engine": ["./vendor/mixo-geocore/pkg-browser/mixo_geometry_wasm.js"]
    }
  },
  // The review page's node editor is TSX bundled on its own (vite.editor.config.ts); without this line
  // nothing typechecked it - its unused parameters passed the gate silently until 2026-11-20.
  // scripts/dental-region-review is the batch's aligner review; tsc never read it, and a call left
  // without its new argument (appSettings(), 2026-11-20) reached a real run before anything noticed.
  "include": ["src", "vendor/mixo-geocore/host", "vendor/mixo-geocore/editing", "vite.config.ts", "typelab/nodeEditor/*.tsx", "scripts/dental-region-review/*.ts"]
}
