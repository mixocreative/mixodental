{
  "name": "mixodental",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "icons:add": "node scripts/icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/third-party-notices.mjs",
    "fonts": "node scripts/gen-fonts-css.mjs",
    "vendor:geometry": "node scripts/vendor-geometry.mjs",
    "vendor:check": "node scripts/vendor-geometry.mjs --check",
    "wasm:test": "node scripts/vendor-geometry.mjs --check && node scripts/geometry-wasm-smoke.mjs",
    "host-example": "node scripts/host-example.mjs",
    "test": "vitest run",
    "screens": "vite-node scripts/step-screens.mjs",
    "walk": "node scripts/walk.mjs",
    "walk:locales": "node scripts/walk.mjs --locales=en,ja,zh-Hant",
    "check:duplicates": "node scripts/check-no-duplicates.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:nogl": "node scripts/no-webgl-gate.mjs",
    "gate:real": "node scripts/real-scan-gate.mjs",
    "gate:tier": "node scripts/real-scan-tier.mjs"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 114",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@fontsource/roboto-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "lucide-static": "^1.68.0",
    "playwright-core": "^1.64.1",
    "subset-font": "^2.9.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.173.0"
  }
}
